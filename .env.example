# ========================================
# DATABASE CONFIGURATION
# ========================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=tecnica_db
DB_USER=dev_user
DB_PASSWORD=dev_password_123
DATABASE_URL=postgresql://dev_user:dev_password_123@postgres:5432/tecnica_db
# Tamaño del pool de conexiones de Postgres (default 10)
DB_POOL_SIZE=10

# ========================================
# BACKEND (NestJS)
# ========================================
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_REFRESH_EXPIRATION=1h

# CORS: orígenes a los que el navegador puede leerles las respuestas de la API,
# separados por coma (`https://app.tudominio.cl,https://admin.tudominio.cl`).
# Origen exacto: esquema://host[:puerto], sin ruta ni barra final, y nunca `*`
# (la API usa credentials): un valor así frena el arranque. Vacía o ausente,
# vale el origen de FRONTEND_URL. El compose de desarrollo no le pasa ninguna de
# las dos al backend (ahí vale localhost:5173): cuenta fuera del compose y en
# Railway. Es defensa en profundidad: desde ADR-022 el navegador llega por el
# proxy del frontend, same-origin, y no depende de CORS.
CORS_ORIGINS=

# ========================================
# FRONTEND (Vue3)
# ========================================
# El navegador NO tiene URL de backend: pide `/api` al propio frontend, que lo
# reenvía (ADR-022). Lo que se configura es el destino de ese reenvío, y lo lee
# el servidor de Nuxt en runtime. Adentro de docker-compose el default correcto
# es `http://backend:3000`, que ya viene puesto ahí.
# ⛔ Va COMENTADO: adentro de docker-compose el destino correcto es la red interna
# (`http://backend:3000`) y ése es el default del compose. Un worktree que copie este
# ejemplo con `localhost:3000` puesto mete ese valor en el contenedor del frontend, que
# entonces se proxea A SÍ MISMO. Descomentar solo para apuntar a un backend remoto.
# API_PROXY_TARGET=http://localhost:3000
VITE_APP_NAME=Prueba Técnica

# ========================================
# GOOGLE OAUTH
# ========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# ========================================
# MAIL (nodemailer contra SMTP propio)
# ========================================
# Con SMTP_HOST VACÍO el backend escribe los mails en el log y NO los envía.
# Eso es lo que permite desarrollar y correr los e2e sin credenciales: el link
# de invitación aparece en el log del backend, clickeable.
#
# Gmail exige 2FA activo + una App Password de 16 caracteres (la contraseña de
# la cuenta NO sirve desde 2022), y reescribe el remitente a la dirección de la
# cuenta: SMTP_FROM no se puede falsear ahí.
#   host smtp.gmail.com · puerto 465 (SSL) o 587 (STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ========================================
# DOCKER — un stack por worktree
# ========================================
# ⛔ COMPOSE_PROJECT_NAME va COMENTADO a propósito, y ésta es la línea más
# importante de este archivo. Fijarlo acá fue la causa raíz del incidente del
# 2026-09-20: cada worktree copió el ejemplo, los cuatro `.env` declararon el mismo
# proyecto de compose, y `reset-db.sh` corrido en un worktree hizo `down -v` sobre
# los contenedores de TODAS las sesiones — informando éxito. Comentado, el default
# de compose es el nombre del directorio, que es único por worktree.
# El checkout principal SÍ lo fija en su propio `.env` (no en este ejemplo), para
# conservar su proyecto, sus nombres de contenedor y su volumen de datos.
# COMPOSE_PROJECT_NAME=tecnica_fullstack

# Puertos y prefijo de contenedor de ESTE worktree. Los escribe
# `./scripts/entorno.sh stack` con un offset propio (1–49); no se editan a mano.
# Sin ellos valen los defaults del compose, que son los puertos del offset 0 (main).
#   offset N → postgres 5432+N · backend 3000+N · frontend 5173+N
# PUERTO_POSTGRES=5432
# PUERTO_BACKEND=3000
# PUERTO_FRONTEND=5173
# PREFIJO_CONTENEDOR=tecnica

# Pasarela de pagos
# Clave maestra de cifrado de credenciales (32 bytes base64). Generar con: openssl rand -base64 32
PASARELA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Emisor DTE: clave de cifrado del certificado digital y los CAF (32 bytes base64). Es propia y distinta
# de la de la pasarela, para que la filtración de una no exponga la otra. Generar con: openssl rand -base64 32
DTE_ENCRYPTION_KEY=JLHn+lnKC1wCp+GmSRpUyuuBf8uwR18F9KyNsn24ews=
# Emisor DTE: servidores de la API de boleta del SII. Sin definir valen estos (los del SII);
# solo se cambian si el SII los mueve (el OpenAPI llama "temporales" a pangal y rahue).
# SII_BOLETA_API_CERTIFICACION=https://apicert.sii.cl/recursos/v1
# SII_BOLETA_ENVIO_CERTIFICACION=https://pangal.sii.cl/recursos/v1
# SII_BOLETA_API_PRODUCCION=https://api.sii.cl/recursos/v1
# SII_BOLETA_ENVIO_PRODUCCION=https://rahue.sii.cl/recursos/v1
# URL pública del backend (para el response_url de Transbank)
API_PUBLIC_URL=http://localhost:3000

# Límites de intentos (ADR-032). Sin definir valen los de producción; el compose
# de desarrollo y el e2e los escalan ×1000 para no chocarlos. Cada conteo se sube
# en Railway con su variable, sin tocar código (las ventanas son fijas):
#   LIMITE_USUARIO_POR_MINUTO=100   LIMITE_ANONIMO_POR_MINUTO=30
#   LIMITE_LOGIN_POR_CORREO=10 (15 min)   LIMITE_LOGIN_POR_IP=30 (15 min)
#   LIMITE_REFRESH_POR_MINUTO=20   LIMITE_TOKEN_POR_MINUTO=10
#   LIMITE_CORREO_POR_DESTINO=3 (hora)   LIMITE_CORREO_POR_IP=10 (hora)
#   LIMITE_PIN_FALLOS=5 (espera de 5 min)
# LIMITES_ESCALA=1
# PROXY_SECRETO=          # el mismo en backend y frontend
# IP_CABECERA_BORDE=      # la cabecera con la IP del cliente que pone el borde (Railway)

# Firmado de QZ Tray (impresión térmica sin diálogo de confianza).
# Generar el par UNA vez con:
#   openssl req -x509 -newkey rsa:2048 -keyout qz-private-key.pem -out qz-cert.pem \
#     -days 3650 -nodes -subj "/CN=Startup POS QZ"
#   base64 -i qz-private-key.pem   # QZ_PRIVATE_KEY
#   base64 -i qz-cert.pem          # QZ_CERTIFICATE
# Si se dejan vacías, la impresión funciona igual pero en modo no-firmado (diálogo).
QZ_PRIVATE_KEY=
QZ_CERTIFICATE=
