#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# pre-commit — gate mecánico de startup-app
#
# Cubre SOLO lo determinista/grepeable de docs/agent/anti-patterns.md:
#   · casing tenant_id (req.user.tenant_id → undefined)
#   · DELETE físico en SQL raw
#   · lint:check (eslint sin --fix) sobre los .ts de backend staged
#   · helpers de e2e que leen el body sin mirar el status de la respuesta
#
# NO cubre el juicio (N+1, SELECT sin `eliminado_el IS NULL`): eso es la revisión
# independiente por sub-agente del skill `verify-feature`, que un hook de shell no
# puede ejecutar. Lo que sí hace es EXIGIRLA: si el diff toca services de backend
# o .vue de pages/components, el commit se bloquea hasta que exista un recibo de
# esa revisión para este diff exacto.
#
# Escape para el caso legítimo raro:  git commit --no-verify
# ─────────────────────────────────────────────────────────────────────────────

fail=0
red()  { printf '\033[31m%s\033[0m\n' "$1"; }
ylw()  { printf '\033[33m%s\033[0m\n' "$1"; }
grn()  { printf '\033[32m%s\033[0m\n' "$1"; }

# Líneas AGREGADAS en .ts staged (excluye tests y este propio hook), sin el prefijo '+'
added_ts_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.ts' \
                 | grep -v -E '\.spec\.ts$|/test/|\.e2e-spec\.ts$')

added_lines() {
  # $1 = patrón egrep sobre líneas agregadas de los .ts staged (sin tests)
  for f in $added_ts_files; do
    git diff --cached -U0 -- "$f" \
      | grep -E '^\+' | grep -v -E '^\+\+\+' \
      | grep -nE "$1" | sed "s#^#$f: #"
  done
}

# ── Guard 1: casing de tenant_id ─────────────────────────────────────────────
hits=$(added_lines 'req\.user\.tenant_id\b')
if [ -n "$hits" ]; then
  red "✗ tenant_id con casing equivocado — el payload JWT es 'tenantId', no 'tenant_id'."
  red "  req.user.tenant_id es undefined → fuga/ruptura multi-tenant."
  echo "$hits"
  echo "  Usar: const { tenantId } = req.user as { tenantId: string }"
  fail=1
fi

# ── Guard 2: DELETE físico en SQL raw ────────────────────────────────────────
hits=$(added_lines 'DELETE[[:space:]]+FROM')
if [ -n "$hits" ]; then
  red "✗ DELETE físico detectado — el proyecto usa soft delete (UPDATE ... eliminado_el = NOW())."
  echo "$hits"
  echo "  Si es un borrado legítimo (tabla efímera/cleanup), commiteá con --no-verify."
  fail=1
fi

# ── Guard 3: lint:check sobre los .ts de backend staged ──────────────────────
backend_ts=$(git diff --cached --name-only --diff-filter=ACM -- 'backend/*.ts' 'backend/**/*.ts')
if [ -n "$backend_ts" ]; then
  # rutas relativas a backend/
  rel=$(printf '%s\n' $backend_ts | sed 's#^backend/##')
  if ! ( cd backend && npx --no-install eslint $rel ) ; then
    red "✗ lint:check falló en archivos de backend staged."
    fail=1
  else
    grn "✓ lint:check OK (backend staged)"
  fi
fi

# ── Guard 4: design tokens sobre .vue staged (neutrales hardcodeados) ─────────
staged_vue=$(git diff --cached --name-only --diff-filter=ACM -- 'frontend/**/*.vue')
if [ -n "$staged_vue" ]; then
  if ! ( cd frontend && node scripts/check-design-tokens.mjs --staged ) ; then
    red "✗ Tokens de diseño en .vue staged (ver arriba)."
    fail=1
  fi
fi

# ── Guard 5: enlaces internos de docs staged ─────────────────────────────────
staged_md=$(git diff --cached --name-only --diff-filter=ACM -- '*.md')
if [ -n "$staged_md" ]; then
  if ! node scripts/check-docs-links.mjs --staged ; then
    red "✗ Enlaces de docs rotos en .md staged (ver arriba)."
    fail=1
  fi

  # ── Guard 6: tablas GFM rotas por un párrafo pegado ────────────────────────
  # Pasó de verdad (2026-08-15): un párrafo insertado entre dos filas hizo que
  # todo lo que seguía dejara de renderizarse como tabla, y ni el hook ni el CI
  # lo vieron. Es un chequeo propio de una sola regla, no un linter de markdown
  # (dependencia nueva descartada).
  if ! node scripts/check-md-tables.mjs --staged ; then
    red "✗ Tabla de markdown rota en .md staged (ver arriba)."
    fail=1
  fi
fi

# ── Guard 7: helpers de e2e que leen el body sin mirar el status ─────────────
# Un helper que hace `return (res.body as X).id` sin aseverar el status reparte
# `undefined` a TODOS sus llamadores cuando la llamada falla, y el rojo aparece
# lejos de su causa (una falla de inventario se leyó como `costoActual:
# undefined` y se diagnosticó en el módulo equivocado). El commit 9784e1b6
# barrió el mismo modo de falla para los tokens; este guard es para que no
# vuelva a crecer. Chequeo propio y no un regex acá porque hay que mirar hacia
# atrás dentro de la función, cosa que grep no hace.
staged_e2e=$(git diff --cached --name-only --diff-filter=ACM -- 'backend/test/*.ts')
if [ -n "$staged_e2e" ]; then
  if ! node scripts/check-e2e-status.mjs --staged ; then
    red "✗ Helper de e2e que lee el body sin mirar el status (ver arriba)."
    fail=1
  fi
fi

# ── Gate: revisión independiente sobre este diff exacto ──────────────────────
# Antes era un aviso. No alcanzó: en la sesión de jul-2026 el hook lo imprimió
# en 4 commits seguidos y las 4 veces se ignoró — un bug de permisos que dejaba
# al rol aprobador sin el botón "Aplicar" llegó a main y lo encontró una
# revisión posterior. Un aviso ignorado 4 de 4 no es un control, así que ahora
# bloquea: el escape sigue existiendo, pero pasa a ser una decisión explícita.
#
# Incluye .vue de pages/components a propósito: aquel bug era un template, y el
# trigger viejo (solo *.service.ts) ni se habría disparado en un commit de
# solo-frontend.
#
# El recibo ata la revisión a ESTE diff: si cambiás algo después de revisar, el
# hash deja de coincidir y hay que revisar de nuevo. Vive en el git-dir — no se
# commitea y muere con el clone. La ruta se resuelve con `git rev-parse
# --git-dir` y no con `.git/` literal porque en un worktree `.git` es un
# ARCHIVO (gitfile): el literal no se podía ni leer ni escribir, así que el
# gate bloqueaba ahí sin salida (medido 2026-08-27). Cada worktree tiene su
# git-dir propio, o sea su recibo propio — que es lo correcto: el recibo es
# del diff staged de ESE checkout.
needs_review=$(git diff --cached --name-only --diff-filter=ACM \
               | grep -E 'backend/src/.*\.service\.ts$|frontend/app/(pages|components)/.*\.vue$' || true)

if [ -n "$needs_review" ]; then
  receipt_file="$(git rev-parse --git-dir)/verify-feature.receipt"
  recorded=$(cat "$receipt_file" 2>/dev/null || echo '')
  actual=$(git diff --cached | git hash-object --stdin)
  if [ "$actual" != "$recorded" ]; then
    red "✗ Este diff no pasó la revisión independiente (verify-feature paso 7)."
    red "  El hook cubre lo grepeable; N+1, filtro de borrado y alcance son juicio."
    ylw "  Archivos que la exigen:"
    echo "$needs_review" | sed 's/^/    /'
    ylw "  Corré el skill verify-feature. Al cerrar en LIMPIO deja el recibo con:"
    ylw "    git diff --cached | git hash-object --stdin > \"\$(git rev-parse --git-dir)/verify-feature.receipt\""
    fail=1
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo
  red "commit BLOQUEADO por el pre-commit. Corregí, o usá 'git commit --no-verify' si es un falso positivo."
  exit 1
fi
exit 0
